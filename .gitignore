# Dependencies
node_modules/
jspm_packages/
bower_components/

# Build output
dist/
build/
out/
.next/
.nuxt/
.cache/
*.tsbuildinfo

# Environment
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
venv/
.venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Databases
*.sqlite
*.sqlite3
*.db
# WAL journal mode (enabled in core/apps.py) writes these sidecars next to the
# database file. The globs above do not match them.
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal

# User uploads — avatars and trip cover photos. Not tracked at all: Django's
# FileSystemStorage creates each `upload_to` directory on first save, so a fresh
# clone needs nothing here.
Backend/media/

# collectstatic output (STATIC_ROOT). Generated, never edited by hand.
Backend/staticfiles/

# Editors
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini

# Internal planning docs — kept local, shared with the team out-of-band
Backend/docs/
Backend/CLAUDE.md
CLAUDE.md
.claude/
