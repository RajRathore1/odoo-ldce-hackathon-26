# Copy to .env — the defaults below work as-is for local development.
#   cp .env.example .env
# .env is gitignored. This file is committed.

DEBUG=True
SECRET_KEY=dev-only-insecure-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Where the frontend runs. Used to build shareable trip links.
FRONTEND_BASE_URL=http://localhost:5173

# CORS — dev.py sets CORS_ALLOW_ALL_ORIGINS=True regardless, so this only
# matters under config.settings.prod.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Auth token lifetimes
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
